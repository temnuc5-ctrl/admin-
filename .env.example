# ── Connexion administrateur ───────────────────────────────────────────────
# Identité attendue à la connexion (insensible à la casse et aux accents).
ADMIN_NOM=Nom
ADMIN_PRENOM=Prenom
# Empreinte du code PIN à 6 chiffres : `node scripts/hash-pin.mjs 123456`
ADMIN_PIN_HASH=sel_hex32:hash_hex128
# Chaîne aléatoire de 32 caractères minimum : `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# ── Supabase (côté serveur uniquement) ─────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Recommandé : les tables sont protégées par RLS. Ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket public qui reçoit les dashboards générés.
SUPABASE_DASHBOARD_BUCKET=dashboards
# Bucket privé consulté par la galerie admin.
SUPABASE_IMAGES_BUCKET=photos-controles

# ── Identité visuelle ──────────────────────────────────────────────────────
SITE_NAME=Portail de supervision
SITE_LABEL=Sites LF · NISSAN · ST
